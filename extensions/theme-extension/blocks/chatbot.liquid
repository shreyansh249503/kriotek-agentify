{% comment %}
  Render Agentify Chatbot Widget
{% endcomment %}
{% assign bot_key = block.settings.bot_public_key_override %}

<script
  src="https://drew-thirteen-heroism.ngrok-free.dev/widget.js"
  {% if bot_key != blank %}
    bot-id="{{ bot_key }}"
  {% else %}
    shop-domain="{{ shop.permanent_domain }}"
  {% endif %}
  defer
></script>

{% schema %}
{
  "name": "Agentify Chatbot",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "bot_public_key_override",
      "label": "Bot Public Key Override",
      "info": "Paste your bot public key here. Find it in your Supabase bots table."
    }
  ]
}
{% endschema %}