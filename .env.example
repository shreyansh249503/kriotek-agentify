# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Postgres Connection String
# Port 6543 (Transaction Mode) is recommended for serverless/Next.js deployments.
# Port 5432 (Session Mode) is used for migrations and direct administrative connections.
SUPABASE_DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# CA certificate (PEM) from Supabase Dashboard → Database → SSL Configuration.
# Enables certificate verification; strongly recommended in production. "\n" escapes are accepted.
SUPABASE_DB_CA_CERT=
# Optional: connections per server instance (default 3 in production, 10 otherwise)
DB_POOL_MAX=
# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash-lite
# Monthly token cap for bots without their own monthly_token_budget (recommended in production)
DEFAULT_MONTHLY_TOKEN_BUDGET=2000000

# Public URLs
NEXT_PUBLIC_WIDGET_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com

# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key
NEXT_PUBLIC_SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-domain.com
# Requested during OAuth install; must match [access_scopes] in shopify.app*.toml
SHOPIFY_SCOPES=read_orders,read_products

# Encryption for stored Shopify access tokens (required in production, >= 32 chars)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: previous key during a rotation, so old tokens stay readable until re-encrypted
# Re-encrypt with: node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/reencrypt-shopify-tokens.mjs --apply
ENCRYPTION_KEY_LEGACY=

# Upstash Redis & Rate Limiting (Optional but recommended for production)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Email notifications (SMTP; any provider: Resend, Postmark, SES, SendGrid)
# Port 465 uses implicit TLS, other ports STARTTLS. EMAIL_FROM may include a name: "Agentify <no-reply@your-domain.com>"
# Legacy fallback when SMTP_HOST is unset: GMAIL_USER + GMAIL_APP_PASSWORD (not for production)
EMAIL_FROM=notifications@your-domain.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password

# Vercel Cron Authentication (Secures /api/cron/* endpoints against unauthorized requests)
# Set in Vercel Project Settings → Environment Variables.
# Generate with: openssl rand -base64 32
CRON_SECRET=eyuPpvnJ2ioHtLzdOdvAHBnPBqKOsn5HNrVHaMJ+J9I=
